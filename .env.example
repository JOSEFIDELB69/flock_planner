# =============================================================================
# Flock Planner — variables de entorno (ejemplo SIN secretos reales)
# Copiá este archivo a backend/.env (desarrollo local) o configuralas en tu
# plataforma cloud / gestor de secretos. Nunca subas valores reales al repositorio.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_BASE_URL=http://localhost:3000  # URL pública del frontend
API_BASE_URL=http://localhost:8000  # URL del backend (la usa el proxy de Next.js; se fija en el build)
CORS_ORIGINS=http://localhost:3000  # orígenes permitidos (coma separada)
DEFAULT_USER=Usuario local          # responsable por defecto en auditoría (sin login multiusuario en v1)

# --- Base de datos (OBLIGATORIA) ----------------------------------------------
# Producción: PostgreSQL (formato: postgresql+psycopg://USUARIO:CLAVE@HOST:5432/BASE, con una clave
# propia que no se sube al repositorio). SQLite solo para desarrollo local o pruebas.
DATABASE_URL=sqlite:///./pm_agent_dev.db

# Contraseña de PostgreSQL para docker compose (obligatoria con Docker; elegí una propia y larga).
POSTGRES_PASSWORD=

# --- IA: Claude Code (CLI local en el servidor del backend) ---------------------
# Requiere la CLI instalada y una sesión iniciada (`claude` → /login).
AI_RATE_LIMIT_PER_MINUTE=20         # límite por IP para endpoints de IA (0 = sin límite)
# Proveedor: claude_code (por defecto) | demo (heurísticas locales, marcadas como simuladas) | none (sin IA)
AI_PROVIDER=claude_code
# CLAUDE_CODE_PATH=                 # ruta a claude/claude.exe si no está en el PATH
# CLAUDE_CODE_MODEL=sonnet          # vacío = modelo por defecto de la CLI
# CLAUDE_CODE_TIMEOUT_SECONDS=300

# --- Integraciones (solo si se usa JIRA) ---------------------------------------
# Clave Fernet para cifrar tokens de integraciones. Generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- Archivos ------------------------------------------------------------------
MAX_UPLOAD_BYTES=1000000            # tamaño máximo de archivos de requisitos (.txt/.md/.csv)
# Los PDF se guardan en la base de datos (tabla exports); no se necesita PDF_STORAGE_PATH.
# PDF_FONT_PATH=/ruta/Fuente.ttf     # opcional: fuente Unicode para PDF
# PDF_FONT_BOLD_PATH=/ruta/Fuente-Bold.ttf

# --- Frontend ------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=local           # etiqueta visible en el encabezado (DEV / TEST / PROD)
